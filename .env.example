# Network Backup Manager — .env example
# Salin file ini menjadi .env dan isi nilainya:
#
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env (Windows)

# ---------------------------------------------------------------------------
# WAJIB — Fernet symmetric encryption key untuk credential passwords di DB.
# Generate key baru dengan perintah:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# JANGAN ubah key ini setelah data sudah terenkripsi!
# ---------------------------------------------------------------------------
SECRET_KEY=your-fernet-key-here

# ---------------------------------------------------------------------------
# Opsional — nilai default sudah tersedia jika tidak diisi
# ---------------------------------------------------------------------------

# Path database SQLite (relatif terhadap root project)
DB_URL=sqlite:///network_backup.db

# Direktori penyimpanan file backup dan session log
BACKUP_DIR=backups

# global_delay_factor untuk Netmiko (naikkan jika device lambat merespons)
NETMIKO_DELAY_FACTOR=4

# Jumlah thread paralel saat backup/push ke banyak device (group)
MAX_WORKERS=5
